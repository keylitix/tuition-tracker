<%- include('../partials/head') %>
<div class="center-narrow">
  <div class="card">
    <h1><%= school.name %></h1>
    <p class="muted">Sign in to view your tuition statement.</p>
    <% if (sent) { %>
      <div class="flash">
        If that email is on file, we've sent a sign-in link. Check your inbox — the link
        expires in a few minutes and works once.
      </div>
      <p><a href="/portal/login">Back</a></p>
    <% } else { %>
      <form method="post" action="/portal/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required autofocus>
        <div style="margin-top:16px"><button type="submit">Email me a sign-in link</button></div>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
