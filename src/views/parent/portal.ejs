<%- include('../partials/head') %>

<h1>Your tuition</h1>

<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<% if (error) { %><div class="errorbox"><%= error %></div><% } %>

<div class="card">
  <div class="muted">Current balance</div>
  <div class="balance-hero money <%= balance.balance > 0 ? 'owed' : 'paidup' %>"><%= money(balance.balance) %></div>
  <div class="muted" style="margin-top:6px">
    Charged <%= money(balance.charged) %> · Paid <%= money(balance.paid) %>
  </div>

  <% if (balance.balance > 0 && hasPlan) { %>
    <div class="flash" style="margin-top:16px">
      You're set up on <strong><%= planLabel %></strong> — your bank is drafted automatically each cycle.
      To change how you pay, please contact the school office.
    </div>
  <% } else if (balance.balance > 0) { %>
    <h2 style="font-size:15px;margin:18px 0 8px">How would you like to pay?</h2>
    <form method="post" action="/portal/checkout" id="payform">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <fieldset class="payopts">
        <legend>Payment method</legend>
        <label><input type="radio" name="method" value="bank" checked> Bank account (ACH) — <strong>no fee</strong></label>
        <label><input type="radio" name="method" value="card"> Credit / debit card — <strong>+<%= feeRatePct %>% convenience fee</strong></label>
      </fieldset>

      <fieldset class="payopts">
        <legend>Plan</legend>
        <label><input type="radio" name="choice" value="full" checked> Pay in full</label>
        <label><input type="radio" name="choice" value="monthly"> Monthly (through May 1)</label>
        <label><input type="radio" name="choice" value="semester"> Semester (now + January 15)</label>
        <% if (custom) { %>
          <label><input type="radio" name="choice" value="other"> Other amount</label>
          <div id="otherwrap" class="otheramt" hidden>
            <label for="payamount" style="margin:2px 0 4px">Amount to pay (max <%= money(custom.balanceDollars) %>)</label>
            <input type="number" id="payamount" name="amount" step="0.01" inputmode="decimal"
                   min="<%= custom.minDollars.toFixed(2) %>" max="<%= custom.balanceDollars.toFixed(2) %>"
                   value="<%= custom.defaultDollars.toFixed(2) %>">
          </div>
        <% } %>
      </fieldset>

      <div id="paysummary" class="paysummary muted"></div>

      <button type="submit" id="paysubmit" style="margin-top:12px">Continue to secure payment</button>
    </form>
    <p class="muted" style="margin-top:10px">
      Payments are handled securely by Stripe. Bank (ACH) drafts are free and take a few business days to clear;
      card payments add a <%= feeRatePct %>% convenience fee. Plans draft your chosen method automatically each cycle.
    </p>
    <script id="paydata" type="application/json"><%- JSON.stringify({ previews: previews, custom: custom, feeRatePct: feeRatePct }) %></script>
    <script src="/public/js/portal.js"></script>
  <% } %>

  <p class="toolbar" style="margin-top:14px">
    <a class="btn secondary" href="/portal/statement.pdf">Download statement (PDF)</a>
    <% if (hasStripeCustomer) { %>
      <a class="btn secondary" href="/portal/billing">Manage bank details</a>
    <% } %>
  </p>
</div>

<div class="card">
  <h2>Students &amp; charges</h2>
  <table>
    <thead><tr><th>Student</th><th>Description</th><th>Year</th><th class="num">Amount</th></tr></thead>
    <tbody>
      <% var visibleCharges = charges.filter(function(c){ return !c.voided; }); %>
      <% if (visibleCharges.length === 0) { %><tr><td colspan="4" class="muted">No charges.</td></tr><% } %>
      <% visibleCharges.forEach(function(c){ %>
        <tr>
          <td><%= c.first_name %> <%= c.last_name %></td>
          <td><%= c.description %></td>
          <td><%= c.school_year %></td>
          <td class="num"><%= money(c.amount) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2>Payment history</h2>
  <table>
    <thead><tr><th>Date</th><th>Method</th><th>Note</th><th class="num">Amount</th></tr></thead>
    <tbody>
      <% if (payments.length === 0) { %><tr><td colspan="4" class="muted">No payments yet.</td></tr><% } %>
      <% payments.forEach(function(p){ %>
        <tr>
          <td><%= fmtDate(p.received_on) %></td>
          <td><%= methodLabel(p.method) %></td>
          <td><%= p.note || '' %></td>
          <td class="num"><span class="money <%= Number(p.amount) < 0 ? 'negative' : '' %>"><%= money(p.amount) %></span></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../partials/foot') %>
