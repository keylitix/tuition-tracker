<%- include('../partials/head') %>

<p class="muted"><a href="/admin">&larr; Families</a></p>
<h1>Settings</h1>

<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<% if (error) { %><div class="errorbox"><%= error %></div><% } %>

<!-- Standard tuition -->
<div class="card">
  <h2>Standard tuition <span class="muted">(per student, per year)</span></h2>
  <p class="muted">Every family starts at this amount per enrolled student. Scholarships, tax credits, and payments are applied afterward to reach the balance.</p>
  <table>
    <thead><tr><th>School year</th><th class="num">Annual tuition / student</th><th>Updated</th><th></th></tr></thead>
    <tbody>
      <% if (rates.length === 0) { %><tr><td colspan="4" class="muted">No rate set yet.</td></tr><% } %>
      <% rates.forEach(function(r){ %>
        <tr>
          <td><%= r.school_year %></td>
          <td class="num"><%= money(r.annual_tuition) %></td>
          <td class="muted"><%= fmtDate(r.updated_at) %></td>
          <td class="num">
            <form class="inline" method="post" action="/admin/settings/tuition/apply-all"
                  onsubmit="return confirm('Re-price every family to <%= money(r.annual_tuition) %> for <%= r.school_year %>? Existing tuition charges that differ will be voided and re-added at this rate.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="school_year" value="<%= r.school_year %>">
              <button class="secondary small" type="submit">Sync all families</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <p class="muted">"Sync all families" applies this rate to every family for that year — adding tuition where missing and re-pricing any that differ. Individual families can also be synced from their own page.</p>
  <form method="post" action="/admin/settings/tuition" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div><label>School year</label><input name="school_year" value="<%= defaultYear %>" placeholder="2026-2027" required></div>
      <div><label>Annual tuition per student</label><input name="annual_tuition" inputmode="decimal" placeholder="6000.00" required></div>
      <div style="display:flex;align-items:flex-end"><button type="submit">Save rate</button></div>
    </div>
  </form>
</div>

<!-- Optional items -->
<div class="card">
  <h2>Optional items</h2>
  <p class="muted">Add-ons the office applies only to students who opt in (e.g. device insurance). These aren't charged automatically.</p>
  <table>
    <thead><tr><th>Item</th><th class="num">Amount</th><th></th></tr></thead>
    <tbody>
      <% if (items.length === 0) { %><tr><td colspan="3" class="muted">No optional items yet.</td></tr><% } %>
      <% items.forEach(function(it){ %>
        <tr class="<%= it.active ? '' : 'voided' %>">
          <td><%= it.name %><% if (!it.active) { %> <span class="muted">(removed)</span><% } %></td>
          <td class="num"><%= money(it.amount) %></td>
          <td class="num">
            <% if (it.active) { %>
              <form class="inline" method="post" action="/admin/settings/items/<%= it.id %>/deactivate"
                    onsubmit="return confirm('Remove this optional item from the catalog? Existing charges are unaffected.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="secondary small" type="submit">Remove</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <form method="post" action="/admin/settings/items" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div><label>Item name</label><input name="name" placeholder="Device insurance" required></div>
      <div><label>Amount</label><input name="amount" inputmode="decimal" placeholder="10.00" required></div>
      <div style="display:flex;align-items:flex-end"><button type="submit">Add item</button></div>
    </div>
  </form>
</div>

<!-- Admins -->
<div class="card">
  <h2>Admins</h2>
  <p class="muted">People who can sign in to the office view. No self-registration — admins are added here by another admin.</p>
  <table>
    <thead><tr><th>Name</th><th>Email</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% admins.forEach(function(a){ %>
        <tr class="<%= a.active ? '' : 'voided' %>">
          <td><%= a.display_name %><% if (a.id === currentAdminId) { %> <span class="muted">(you)</span><% } %></td>
          <td><%= a.email %></td>
          <td><%= a.active ? 'Active' : 'Removed' %></td>
          <td class="num">
            <% if (a.active && a.id !== currentAdminId) { %>
              <form class="inline" method="post" action="/admin/settings/admins/<%= a.id %>/deactivate"
                    onsubmit="return confirm('Remove <%= a.email %> as an admin? They will no longer be able to sign in.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="secondary small" type="submit">Remove</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <form method="post" action="/admin/settings/admins" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div><label>Name</label><input name="display_name" placeholder="Office Staff" required></div>
      <div><label>Email</label><input name="email" type="email" placeholder="name@school.org" required></div>
      <div><label>Password <span class="muted">(min 8 chars)</span></label><input name="password" type="password" autocomplete="new-password" required></div>
      <div style="display:flex;align-items:flex-end"><button type="submit">Add admin</button></div>
    </div>
    <p class="muted" style="margin-top:8px">Entering an existing admin's email resets their password.</p>
  </form>
</div>

<%- include('../partials/foot') %>
