<%- include('../partials/head') %>

<p class="muted"><a href="/admin">&larr; Families</a></p>
<h1>Import families</h1>

<% if (typeof error !== 'undefined' && error) { %><div class="errorbox"><%= error %></div><% } %>

<!-- Step-by-step for the office -->
<div class="card" style="background:#eef3fb;border-color:#cfddf1">
  <h2 style="margin-top:14px">How to import your families</h2>
  <ol style="margin:6px 0 0;padding-left:20px;line-height:1.9">
    <li><a class="btn small" href="/admin/import/template.csv">Download the template</a> — a spreadsheet with the right columns.</li>
    <li>Open it in Excel or Google Sheets. <strong>Replace the example rows</strong> with your families — one row per student, repeating the family name/email for siblings.</li>
    <li>Save it as CSV, then <strong>upload it below</strong> and click Import. The standard tuition is applied to each student automatically.</li>
    <li>Then review each family for PCTC awards or scholarships, and email their sign-in link.</li>
  </ol>
  <p class="muted" style="margin:12px 0 0">Set the <a href="/admin/settings">standard tuition rate</a> before importing so it can be applied. Re-running an import is safe — families/students already in the system are matched, never duplicated.</p>
</div>

<% if (result) { %>
  <div class="card">
    <h2>Import result</h2>
    <div class="summary">
      <div class="tile"><div class="label">Rows processed</div><div class="value"><%= result.rowsProcessed %></div></div>
      <div class="tile"><div class="label">Families</div><div class="value"><%= result.familiesCreated %> new</div><div class="muted"><%= result.familiesMatched %> matched</div></div>
      <div class="tile"><div class="label">Students</div><div class="value"><%= result.studentsCreated %> new</div><div class="muted"><%= result.studentsSkipped %> existing</div></div>
      <div class="tile"><div class="label">Charges</div><div class="value"><%= result.chargesCreated %> new</div><div class="muted"><%= result.chargesSkipped %> existing</div></div>
      <div class="tile"><div class="label">Tuition applied</div><div class="value"><%= (result.tuitionApplied || 0) %></div><div class="muted">students</div></div>
    </div>
    <% if (result.errors.length) { %>
      <div class="errorbox">
        <strong><%= result.errors.length %> row issue(s)</strong> — those rows were skipped, the rest imported:
        <ul style="margin:8px 0 0">
          <% result.errors.forEach(function(e){ %><li>Row <%= e.row %>: <%= e.message %></li><% }); %>
        </ul>
      </div>
    <% } else { %>
      <div class="flash">No errors. <a href="/admin">View the roster &rarr;</a></div>
    <% } %>
  </div>
<% } %>

<div class="card">
  <h2>Upload your file</h2>
  <form method="post" action="/admin/import">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="csv-file">Choose your filled-in CSV file</label>
    <input id="csv-file" type="file" accept=".csv,text/csv">
    <p id="csv-file-name" class="muted" style="margin:6px 0 0"></p>

    <details style="margin-top:14px">
      <summary class="muted">…or paste the rows directly</summary>
      <textarea id="csv" name="csv" rows="10" style="margin-top:8px;font-family:ui-monospace,Menlo,Consolas,monospace" placeholder="Family Name,Family Email,Student First Name,Student Last Name,Grade,School Year
Doe Family,doe@example.com,Jane,Doe,3,2026-2027
Doe Family,doe@example.com,John,Doe,5,2026-2027"><%= csv %></textarea>
    </details>

    <div style="margin-top:14px"><button type="submit">Import</button></div>
  </form>
  <p class="muted" style="margin-top:10px">Columns accepted (from the template): Family Name, Family Email, Family Phone, Student First Name, Student Last Name, Grade, School Year.</p>
</div>

<script src="/public/js/import.js"></script>

<%- include('../partials/foot') %>
