<%- include('../partials/head') %>
<div class="center-narrow">
  <div class="card">
    <h1>Reset password</h1>
    <% if (sent) { %>
      <div class="flash">
        If that email belongs to an admin account, we've sent a reset link. Check your inbox —
        the link expires in <%= 30 %> minutes and works once.
      </div>
      <p><a href="/admin/login">Back to sign in</a></p>
    <% } else { %>
      <p class="muted">Enter your admin email and we'll send you a link to set a new password.</p>
      <form method="post" action="/admin/forgot">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required autofocus>
        <div style="margin-top:16px"><button type="submit">Email me a reset link</button></div>
      </form>
      <p class="muted" style="margin:14px 0 0"><a href="/admin/login">Back to sign in</a></p>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
