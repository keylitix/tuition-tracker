<%- include('../partials/head') %>
<div class="center-narrow">
  <div class="card">
    <h1>Admin sign in</h1>
    <% if (typeof notice !== 'undefined' && notice) { %><div class="flash"><%= notice %></div><% } %>
    <% if (error) { %><div class="errorbox"><%= error %></div><% } %>
    <form method="post" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <div style="margin-top:16px"><button type="submit">Sign in</button></div>
    </form>
    <p class="muted" style="margin:14px 0 0"><a href="/admin/forgot">Forgot your password?</a></p>
  </div>
</div>
<%- include('../partials/foot') %>
