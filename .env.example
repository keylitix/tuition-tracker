# Copy to .env for local development. NEVER commit the real .env.
# On SmarterASP.NET, set these in web.config <appSettings> instead (see web.config.example).

# --- App ---
NODE_ENV=development
PORT=3000
# Base URL used to build magic links in emails (no trailing slash)
APP_BASE_URL=http://localhost:3000
# Long random string for signing session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# --- SQL Server ---
# For local Docker (see docker-compose.yml): host localhost, the SA password below.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=tuition
DB_USER=sa
DB_PASSWORD=Your_strong_Passw0rd!
# true for Azure / hosts requiring TLS; false for local Docker
DB_ENCRYPT=false
# true to trust self-signed certs (local dev / some shared hosts)
DB_TRUST_SERVER_CERT=true

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: base URL of the Stripe Customer Portal link shown to parents.
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/xxx

# --- Email (magic links) ---
# Leave SMTP_HOST blank in dev to log magic links to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="The Farm Academy <office@thefarmacademy.example>"

# --- School branding (PDF letterhead) ---
SCHOOL_NAME=The Farm Academy
SCHOOL_ADDRESS=Oklahoma
