{
  "name": "tuition-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Tuition ledger for a small private school (Keylitix / The Farm Academy). Tracks obligation; Stripe owns money movement.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "createadmin": "node src/scripts/create-admin.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mssql-v2": "^6.0.0",
    "csv-stringify": "^6.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "mssql": "^11.0.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "stripe": "^16.9.0"
  },
  "devDependencies": {}
}
